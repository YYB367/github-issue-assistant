ALLOWED_REPOSITORY=YYB367/learning-mcp-server
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Public read-only calls work without a token, subject to GitHub rate limits.
GITHUB_TOKEN=
# Opt-in only after configuring a token scoped to your test repository, Issues:write.
GITHUB_WRITES_ENABLED=false
TASK_TIMEOUT_SECONDS=90
GITHUB_TIMEOUT_SECONDS=10
MODEL_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS=6
MAX_MODEL_CALLS=8
KNOWLEDGE_ENABLED=true
RETRIEVAL_TOP_K=3
RETRIEVAL_MAX_DISTANCE=0.40
HISTORY_TOP_K=2
HISTORY_MAX_DISTANCE=0.30
KEYWORD_FALLBACK_ENABLED=true
# Optional absolute path; V4 default is this project's work/sessions-v4.sqlite3.
# STATE_DB_PATH=D:/your-project/work/sessions-v4.sqlite3

# Optional absolute JSON event log path; rotates at 1MB with 3 backups.
# LOG_PATH=D:/your-project/work/logs/events.jsonl

# One canonical DB. Relative paths resolve against the project, not the shell directory.
# Keep the existing effective file when upgrading. Do not overwrite a configured .env.
# STATE_DB_PATH=work/sessions-v4.sqlite3
LAUNCH_PORT=8008
AUTO_BACKUP_ENABLED=true
